{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "lib/**"],
      "env": [
        "AYVAGO_DEV_GAMES",
        "AYVAGO_DEV_ENTRY_OVERRIDES",
        "AYVAGO_DEV_ARCADE_ORIGIN",
        "NEXT_PUBLIC_FIREBASE_*"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
