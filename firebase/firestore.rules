rules_version = '2';

// Deny by default. Collections are opened one by one, each with rules tests
// (firebase/tests) running against the emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin-set custom claim; banned players can still browse but never write.
    function notBanned() {
      return request.auth.token.get('banned', false) != true;
    }

    // Guests are Firebase anonymous users; linking a provider keeps the uid.
    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Same rule as USERNAME_PATTERN in packages/shared/src/profile.ts.
    function validUsername(name) {
      return name is string
        && name.matches('^[A-Za-zÇĞİÖŞÜçğıöşü][A-Za-z0-9_ÇĞİÖŞÜçğıöşü]{2,19}$');
    }

    function validLocale(locale) {
      return locale in ['en', 'tr'];
    }

    // Optional preference fields: absent, or one of the allowed values. Avatar ids are
    // "<glyph>-<color>" from apps/web/lib/account/avatars.ts.
    function validPreferences(data) {
      return (!('avatarId' in data) || (data.avatarId is string && data.avatarId.matches('^[a-z]{2,12}-[a-z]{2,12}$')))
        && (!('theme' in data) || data.theme in ['retro', 'cartoon', 'minimal'])
        && (!('mode' in data) || data.mode in ['system', 'light', 'dark']);
    }

    // users/{uid}: the player's own profile. Created by the client on first sign-in
    // (Spark plan: no Cloud Functions yet). The username is fixed at creation until
    // username changes ship with a reservation Function. Players may delete their own data
    // (account deletion from the settings page).
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid) && notBanned()
        && request.resource.data.keys().hasOnly(['username', 'isGuest', 'locale', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['username', 'isGuest', 'locale', 'createdAt', 'updatedAt'])
        && validUsername(request.resource.data.username)
        && request.resource.data.isGuest == isAnonymous()
        && validLocale(request.resource.data.locale)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid) && notBanned()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isGuest', 'locale', 'avatarId', 'theme', 'mode', 'updatedAt'])
        && request.resource.data.isGuest == isAnonymous()
        && validLocale(request.resource.data.locale)
        && validPreferences(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid);

      // The player's library (favorites, recently played, best scores) as one document, so
      // loading it costs a single read. Limits match packages/shared/src/library.ts. Best scores
      // here are player-reported; leaderboards will use server-validated sessions.
      match /library/state {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && notBanned()
          && request.resource.data.keys().hasOnly(['favorites', 'recent', 'best', 'updatedAt'])
          && request.resource.data.keys().hasAll(['favorites', 'recent', 'best', 'updatedAt'])
          && request.resource.data.favorites is list
          && request.resource.data.favorites.size() <= 200
          && request.resource.data.recent is list
          && request.resource.data.recent.size() <= 20
          && request.resource.data.best is map
          && request.resource.data.best.size() <= 300
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
