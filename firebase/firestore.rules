rules_version = '2';

// Deny by default. Collections are opened one by one, each with rules tests
// (firebase/tests) running against the emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin panel users carry the `admin` custom claim (granted by the "Grant admin role"
    // workflow). Admins only get extra reads; their changes go through Cloud Functions.
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Admin-set custom claim; banned players can still browse but never write.
    function notBanned() {
      return request.auth.token.get('banned', false) != true;
    }

    // Guests are Firebase anonymous users; linking a provider keeps the uid.
    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Same rule as USERNAME_PATTERN in packages/shared/src/profile.ts.
    function validUsername(name) {
      return name is string
        && name.matches('^[A-Za-zÇĞİÖŞÜçğıöşü][A-Za-z0-9_ÇĞİÖŞÜçğıöşü]{2,19}$');
    }

    function validLocale(locale) {
      return locale in ['en', 'tr'];
    }

    // Same list as CHARACTER_IDS in packages/shared/src/characters.ts (docs/adr/0013).
    function validCharacter(id) {
      return id in ['adventurer', 'explorer', 'rookie', 'soldier', 'zombie'];
    }

    // Optional preference fields: absent, or one of the allowed values. Avatar ids are
    // "<glyph>-<color>" from apps/web/lib/account/avatars.ts; character ids come from the shared
    // character list (removing the field means "no choice": games use their default).
    // `changed` is the set of keys this write touches. The character is checked only when it
    // changes, so a profile still holding a retired id (the alien characters, slice 5.1b) can
    // update its other fields; the app reads such an id as "no choice". The theme works the same
    // way: a stored 'retro' (retired in slice 5.11) stays valid, the app reads it as 'arcade'.
    // `invitesOff` is the "do not disturb" switch for table invites (slice 5.18, ADR 0019).
    // `hideOnline` is the "Show me as online" switch turned off (slice 5.21, ADR 0021).
    function validPreferences(data, changed) {
      return (!('avatarId' in data) || (data.avatarId is string && data.avatarId.matches('^[a-z]{2,12}-[a-z]{2,12}$')))
        && (!('characterId' in changed) || !('characterId' in data) || validCharacter(data.characterId))
        && (!('theme' in changed) || !('theme' in data) || data.theme in ['cartoon', 'minimal', 'arcade'])
        && (!('mode' in data) || data.mode in ['system', 'light', 'dark'])
        && (!('invitesOff' in data) || data.invitesOff is bool)
        && (!('hideOnline' in data) || data.hideOnline is bool);
    }

    // users/{uid}: the player's own profile. Created by the client on first sign-in
    // (Spark plan: no Cloud Functions yet). The username is fixed at creation until
    // username changes ship with a reservation Function. Players may delete their own data
    // (account deletion from the settings page).
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid) && notBanned()
        && request.resource.data.keys().hasOnly(['username', 'isGuest', 'locale', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['username', 'isGuest', 'locale', 'createdAt', 'updatedAt'])
        && validUsername(request.resource.data.username)
        && request.resource.data.isGuest == isAnonymous()
        && validLocale(request.resource.data.locale)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid) && notBanned()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isGuest', 'locale', 'avatarId', 'characterId', 'theme', 'mode', 'invitesOff', 'hideOnline', 'updatedAt'])
        && request.resource.data.isGuest == isAnonymous()
        && validLocale(request.resource.data.locale)
        && validPreferences(request.resource.data, request.resource.data.diff(resource.data).affectedKeys())
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid);

      // Play statistics per game, written by the score-session functions only.
      match /stats/{gameId} {
        allow read: if isOwner(uid) || isAdmin();
      }

      // People the player shared a table or a two-player room with (docs/adr/0021), written by
      // the recordRoomPlayers and syncLobbyTable triggers only. The owner reads them.
      match /recentPlayers/{otherUid} {
        allow read: if isOwner(uid);
      }

      // Rewarded-ad tickets and grants (grantAdReward, docs/adr/0023), kept with the player so
      // account deletion removes them. The owner reads them; nobody writes them from a client. The
      // daily counters (adQuota/{day}) are functions-only: no rule, so they stay closed.
      match /adRewards/{rewardId} {
        allow read: if isOwner(uid) || isAdmin();
      }

      // XP, level and achievements (docs/adr/0016-achievements-and-xp.md), awarded by
      // finishSession only. Nobody writes it from a client; xp and level on the profile above are
      // a server-written copy and are not in the profile's writable keys either.
      match /progress/summary {
        allow read: if isOwner(uid) || isAdmin();
      }

      // The player's library (favorites, recently played, best scores) as one document, so
      // loading it costs a single read. Limits match packages/shared/src/library.ts. Best scores
      // here are player-reported; leaderboards use server-validated sessions.
      match /library/state {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && notBanned()
          && request.resource.data.keys().hasOnly(['favorites', 'recent', 'best', 'updatedAt'])
          && request.resource.data.keys().hasAll(['favorites', 'recent', 'best', 'updatedAt'])
          && request.resource.data.favorites is list
          && request.resource.data.favorites.size() <= 200
          && request.resource.data.recent is list
          && request.resource.data.recent.size() <= 20
          && request.resource.data.best is map
          && request.resource.data.best.size() <= 300
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }
    }

    // Leaderboards are public and written by Cloud Functions only (finishSession). Entries hold
    // accepted scores only (flagged ones wait in scoreFlags/), so anyone may read them, e.g. to
    // count a player's rank. Spec: docs/specs/leaderboards.md §9.
    match /leaderboards/{gameId}/boards/{board} {
      allow read: if true;
      match /entries/{uid} {
        allow read: if true;
      }
    }
    match /leaderboards/{gameId}/seasons/{season} {
      allow read: if true;
    }

    // Vote counters and ranking scores are public; votes are written through castVote only, and
    // a player may read their own vote. Daily play counts and feedback are for admins.
    // Spec: docs/specs/voting.md §5.
    match /games/{gameId} {
      allow read: if true;
      match /votes/{uid} {
        allow read: if isOwner(uid) || isAdmin();
      }
      match /feedback/{day} {
        allow read: if isAdmin();
      }
      match /daily/{day} {
        allow read: if isAdmin();
      }
    }
    match /rankings/catalog {
      allow read: if true;
    }

    // Review queues for the admin panel; written by Cloud Functions only.
    match /scoreFlags/{sessionId} {
      allow read: if isAdmin();
    }
    match /sessions/{sessionId} {
      allow read: if isAdmin();
    }
    match /usernames/{key} {
      allow read: if isAdmin();
    }

    // Ads (Phase 3, docs/adr/0023-ads-behind-an-admin-switch.md). config/ads holds the switch and
    // the caps every visitor's browser follows, so anyone may read it; it holds nothing private.
    // Admins write it from the admin panel; a missing document means "ads off". The ranges match
    // AD_SETTING_LIMITS in packages/shared/src/ads.ts. Other config/ documents stay closed.
    function validAdSettings(d) {
      return d.keys().hasOnly(['enabled', 'rewarded', 'interstitial', 'banner', 'testMode',
          'cmpConfirmed', 'interstitialGapSeconds', 'interstitialsPerSession',
          'interstitialsPerDay', 'rewardedPerDay', 'rewardAmount', 'updatedAt'])
        && d.keys().hasAll(['enabled', 'rewarded', 'interstitial', 'banner', 'testMode',
          'cmpConfirmed', 'interstitialGapSeconds', 'interstitialsPerSession',
          'interstitialsPerDay', 'rewardedPerDay', 'rewardAmount', 'updatedAt'])
        && d.enabled is bool && d.rewarded is bool && d.interstitial is bool
        && d.banner is bool && d.testMode is bool && d.cmpConfirmed is bool
        && d.interstitialGapSeconds is int
        && d.interstitialGapSeconds >= 180 && d.interstitialGapSeconds <= 3600
        && d.interstitialsPerSession is int
        && d.interstitialsPerSession >= 0 && d.interstitialsPerSession <= 50
        && d.interstitialsPerDay is int
        && d.interstitialsPerDay >= 0 && d.interstitialsPerDay <= 200
        && d.rewardedPerDay is int && d.rewardedPerDay >= 0 && d.rewardedPerDay <= 200
        && d.rewardAmount is int && d.rewardAmount >= 0 && d.rewardAmount <= 1000
        && d.updatedAt == request.time;
    }

    match /config/ads {
      allow read: if true;
      allow create, update: if isAdmin() && validAdSettings(request.resource.data);

      // Who changed the settings and when: one entry per save, written by the admin who saved,
      // never changed afterwards. Admins only (it names admin accounts).
      match /history/{entryId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['by', 'name', 'at', 'enabled', 'settings'])
          && request.resource.data.keys().hasAll(['by', 'name', 'at', 'enabled', 'settings'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.at == request.time
          && request.resource.data.enabled is bool
          && request.resource.data.settings is map;
      }
    }

    // remove_ads and later purchases (roadmap §9.2). Written by the purchase webhooks only (a
    // later slice); the player reads their own, admins read all.
    match /entitlements/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }

    // voteRate/ is Functions-only: it falls through to the rule below.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
