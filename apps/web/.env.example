# Copy to .env.local for local development. Never commit real values.
# Firebase web config (public by design; access is enforced by Security Rules and App Check).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Facebook sign-in (slice 5.33, docs/setup/phase-5.md): 1 shows the "Continue with Facebook"
# button. Set it only after the Meta app exists and Facebook is enabled in Firebase Auth.
NEXT_PUBLIC_FACEBOOK_SIGN_IN=
# Server only, read at build time: proxies /__/auth/* to the project's Firebase Hosting origin
# (https://<project-id>.firebaseapp.com), so NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN can be the site's
# own domain (sign-in popups on Safari and iOS). Unset: nothing is proxied.
FIREBASE_AUTH_PROXY_ORIGIN=

# Local development only (never on Vercel): use the Firebase Emulator Suite instead of a real
# project. Start it with `pnpm --filter @ayvago/firebase emulators`.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1

# Server only: service account JSON for firebase-admin (SSR catalog pages).
FIREBASE_SERVICE_ACCOUNT=

# Server only: Cloudflare Realtime TURN for online matches (GET /api/ice-servers). Without them
# players get STUN only and fall back to the database relay (docs/setup/phase-4.md).
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Ads (Phase 3, docs/setup/phase-3.md). Public by design (they appear in the ad tag). Without the
# client ID the ad code stays inert; ads also stay off until an admin turns them on in /admin.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
# The address for privacy and KVKK requests shown on /privacy.
NEXT_PUBLIC_PRIVACY_CONTACT=
