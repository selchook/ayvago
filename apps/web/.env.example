# Copy to .env.local for local development. Never commit real values.
# Firebase web config (public by design; access is enforced by Security Rules and App Check).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Local development only (never on Vercel): use the Firebase Emulator Suite instead of a real
# project. Start it with `pnpm --filter @ayvago/firebase emulators`.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1

# Server only: service account JSON for firebase-admin (SSR catalog pages).
FIREBASE_SERVICE_ACCOUNT=
